[Unit]
Description=Agentora speech service: Qwen3-TTS voice (GPU, via the GPU broker) and whisper listening (CPU) on 127.0.0.1:7895
After=network.target agentora-gpu.service
Wants=agentora-gpu.service

[Service]
ExecStart=%h/venv-speech/bin/python %h/yue2-xpu-radio/studio/speech_server.py --port 7895
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_OFFLINE=1
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
