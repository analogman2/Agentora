[Unit]
Description=Agentora second Ollama on 127.0.0.1:11436, RX 7900 XTX only (ROCm); reads the system Ollama's models
After=network.target

[Service]
# A private copy of Ollama with only its ROCm add-on (~/.local/ollama-rocm: no cuda_v*/vulkan libs,
# so it can't touch the 4090). Vulkan ran Qwen 3.5/3.6 ~10x slower. Don't set CUDA_VISIBLE_DEVICES:
# HIP honours it too and then sees no card.
ExecStart=%h/.local/ollama-rocm/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11436
Environment=OLLAMA_MODELS=/usr/share/ollama/.ollama/models
# The model files belong to the system Ollama; never prune or rewrite them from here.
Environment=OLLAMA_NOPRUNE=1
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_KEEP_ALIVE=-1
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
